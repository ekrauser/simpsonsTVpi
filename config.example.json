{
  "_comment": "Copy to config.json (install.sh does this). Relative paths are relative to the repo.",

  "media_dirs": ["videos", "/mnt/simpsonstv"],

  "playlist_dir": "playlists",
  "schedule_file": "playlists/schedule.json",
  "state_dir": "state",

  "extensions": [".mp4", ".mkv", ".m4v", ".mov"],

  "player_cmd": ["omxplayer", "--no-osd", "--aspect-mode", "fill", "{file}"],

  "rescan_seconds": 300,
  "retry_seconds": 15,

  "remote": {
    "http_port": 8080,
    "mqtt": {
      "host": "",
      "port": 1883,
      "username": "",
      "password": "",
      "prefix": "simpsonstv",
      "discovery_prefix": "homeassistant",
      "device_name": "Simpsons TV"
    }
  }
}
