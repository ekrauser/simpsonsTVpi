#!/usr/bin/env bash
# Control the Simpsons TV from a shell.
#
#   tvctl status          what's playing, which playlist, and why
#   tvctl list            playlists and how many episodes each resolves to
#   tvctl set NAME        force a playlist (survives reboot) and skip ahead
#   tvctl auto            back to the date schedule
#   tvctl next            skip the current episode
#   tvctl show NAME       print the files a playlist resolves to
#   tvctl log             follow the player log
#   tvctl restart         restart the player, button and remote services
#
# Remote control (phone / Home Assistant): see remote.py and the README.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
STATE="$HERE/state"
PLAYER="$HERE/player.py"

case "${1:-status}" in
    status)   python3 "$PLAYER" --status
              [ -f "$STATE/override" ] && echo "override:        $(cat "$STATE/override")"
              ;;
    list)     python3 "$PLAYER" --list ;;
    show)     python3 "$PLAYER" --resolve "${2:?usage: tvctl show NAME}" ;;
    set)      python3 "$HERE/control.py" set "${2:?usage: tvctl set NAME}" ;;
    auto)     python3 "$HERE/control.py" auto ;;
    next)     python3 "$HERE/control.py" next ;;
    log)      journalctl -u tvplayer -f -n 50 ;;
    restart)  sudo systemctl restart tvplayer tvbutton tvremote; echo "restarted" ;;
    *)        sed -n '2,12p' "$0"; exit 1 ;;
esac
